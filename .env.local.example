# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in real values. Never commit .env.local.
# ---------------------------------------------------------------------------

# Google Sheets service account (Sheet must be SHARED with this email as Editor)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Paste the private_key from the service-account JSON. Keep the quotes and the
# literal \n sequences exactly as they appear in the JSON.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
# The ID from the sheet URL: docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=your-spreadsheet-id

# Session cookie signing secret — generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-string

# Admin logins as email:password pairs, comma-separated. These are the ONLY
# accounts that can open the dashboard. Choose strong passwords.
# NOTE: passwords must not contain a comma (the pair separator).
ADMIN_USERS=ratnesh.yadav@nuvoco.com:CHANGE_ME_1,scp.guesthouse@nuvoco.com:CHANGE_ME_2
